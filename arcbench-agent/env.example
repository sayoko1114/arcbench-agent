# Official course Lab02 defaults, checked 2026-09-29. Fill only the key locally.
# https://github.com/code-philia/agentic-software-engineering-hackathon/blob/main/Lab/Lab02/.env.example
# Never put a real key in a ZIP.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.arc-bench.com/v1
MODEL=deepseek-v4-flash
# These stop limits are NOT a CNY budget guarantee.
AGENT_MAX_CALLS=100
AGENT_MAX_TOTAL_TOKENS=800000
AGENT_RESPONSE_TOKENS=12000
AGENT_SECONDS=10800
